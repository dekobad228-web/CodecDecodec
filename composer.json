{
    "name": "deko/codec-decodec",
    "description": "Library of symmetric encryption algorithms with format-preserving encryption (FPE)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "encryption",
        "ff1",
        "format-preserving-encryption",
        "fpe",
        "aes",
        "nist"
    ],
    "homepage": "https://github.com/dekobad228-web/CodecDecodec",
    "support": {
        "issues": "https://github.com/dekobad228-web/CodecDecodec/issues",
        "source": "https://github.com/dekobad228-web/CodecDecodec"
    },
    "autoload": {
        "psr-4": {
            "CodecDecodec\\": "src/"
        }
    },
    "authors": [
        {
            "name": "deko",
            "email": "deko.bad228@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpbench/phpbench": "^1.7",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "scripts": {
        "test": "phpunit",
        "benchmark": "phpbench run benchmark --report=default --php-config='{\"opcache.enable_cli\": true}'"
    }
}